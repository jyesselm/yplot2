# Per-paper environment lockfile template
# ========================================
# Fill in exact versions from `pip freeze` after setting up your environment.
# Commit this file with your paper to guarantee reproducible figure regeneration.
#
# Core (required):
yplot2==<VERSION>
matplotlib==<VERSION>
numpy==<VERSION>
#
# Statistical plots (optional, required for violin/box/kde):
seaborn==<VERSION>
#
# Notebook execution (optional, required for .ipynb regen):
nbconvert==<VERSION>
ipykernel==<VERSION>
#
# Example of a filled-in lockfile:
#   yplot2==0.1.0
#   matplotlib==3.10.7
#   numpy==2.2.0
#   seaborn==0.13.2
#   nbconvert==7.16.4
#   ipykernel==6.29.5
